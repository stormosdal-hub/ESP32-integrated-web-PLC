# variant B: octal PSRAM enabled, active-low plain LED, Modbus on another port
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_PLC_STATUS_LED_GPIO=y
CONFIG_PLC_STATUS_LED_PIN=38
CONFIG_PLC_STATUS_LED_ACTIVE_LOW=y
CONFIG_PLC_MODBUS_PORT=1502
CONFIG_PLC_PSRAM_PINS_RESERVED=y
