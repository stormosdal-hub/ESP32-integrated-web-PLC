# ESP-IDF build output and generated config: build/ + sdkconfig (ESP32-S3),
# build_<chip>/ + sdkconfig.<chip> (tools/idf.ps1 -Chip <chip>), test variants.
# The generated sdkconfig files may hold your Wi-Fi password.
build/
build_*/
/sdkconfig*
!/sdkconfig.defaults*
managed_components/
# (dependencies.lock.<chip> ARE committed: they pin the component versions)

# host builds: parity tests, emulator engine, emulator's stored program
build_host/

# parity cases are regenerated by test/parity/make_cases.js on every run
test/parity/cases/
test/parity/fuzz_crash_*.json

# Python / editors / OS
__pycache__/
*.pyc
.vscode/settings.json
.DS_Store
Thumbs.db

# Flash-PLC.cmd menu: your last chip / port / action
tools/flash_menu.last
